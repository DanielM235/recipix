# Environment Variables Example
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Application Base Configuration
APP_NAME=recipix
NODE_ENV=production

# Network Configuration
# The port that the backend will listen on (internal container port)
BACKEND_PORT=3001
# The port that will be exposed on the host machine (for nginx reverse proxy)
HOST_PORT=3001

# Path Configuration
# Base path where the application is deployed on the host (e.g., /my-path/fintools/)
APP_BASE_PATH=/my-path/fintools
# Public URL base path for frontend routing (e.g., /receipts)
PUBLIC_BASE_PATH=/receipts
# API base URL for frontend calls (should match nginx proxy configuration)
API_BASE_URL=https://example.com/receipts/api

# CORS Configuration
# Frontend URL (where the app will be accessible)
FRONTEND_URL=https://example.com/receipts
CORS_ORIGIN=https://example.com

# Frontend Static Files Configuration (Production)
# Path to frontend build directory (optional - defaults to ../frontend/dist)
# FRONTEND_DIST_PATH=/app/frontend/dist

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret (REQUIRED - Generate a strong random key)
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY_IN_PRODUCTION

# Session Secret (REQUIRED - Generate a strong random key)  
# Use: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_SESSION_SECRET_IN_PRODUCTION

# Bcrypt Rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# =============================================================================
# ADMIN USER CONFIGURATION
# =============================================================================

# Initial Admin User (REQUIRED for first-time setup)
# This user will be created automatically if it doesn't exist
ADMIN_EMAIL=admin@localhost.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type (sqlite/postgresql/mysql)
DB_TYPE=sqlite
# SQLite Configuration (for local file-based database)
DATABASE_PATH=/app/data/recipix.db
# PostgreSQL/MySQL Configuration (if using external database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recipix
DB_USER=recipix_user
DB_PASSWORD=CHANGE_THIS_TO_A_SECURE_DB_PASSWORD

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/app/uploads
# Logs Directory
LOG_DIR=/app/logs
# Data Directory (for database and persistent files)
DATA_DIR=/app/data

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Firefly III Configuration
FIREFLY_III_URL=https://your-firefly-instance.com
FIREFLY_III_TOKEN=your-personal-access-token

# OCR Service Configuration (optional)
OCR_API_KEY=your-ocr-api-key
OCR_SERVICE_URL=https://api.ocr.space/parse/image

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info
# Log Format (json, simple)
LOG_FORMAT=json

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# These are only used in development mode
DEV_FRONTEND_PORT=3000
DEV_BACKEND_PORT=3001
DEV_CORS_ORIGIN=http://localhost:3000
