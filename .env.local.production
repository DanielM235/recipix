# ====================================
# Local Production Testing Environment
# ====================================

# Application Configuration
NODE_ENV=production
APP_NAME=recipix
LOG_LEVEL=info

# Network Configuration - Local Testing
PORT=3001
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
HOST=0.0.0.0

# Path Configuration - Local Testing
PUBLIC_BASE_PATH=/receipts
API_BASE_URL=http://localhost:3001/receipts/api

# Security Configuration (Generate new keys for production!)
JWT_SECRET=local-test-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Database Configuration - Local Testing
DATABASE_PATH=/app/data/recipix.db

# File Storage Configuration - Local Testing
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
SUPPORTED_FORMATS=jpg,jpeg,png,pdf

# Rate Limiting - Local Testing
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External Services (Optional for local testing)
TESSERACT_CACHE_PATH=/app/cache/tesseract