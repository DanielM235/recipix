# Production Environment Configuration
# Copy this file to .env for production deployment

# =============================================================================
# DEPLOYMENT CONFIGURATION - CUSTOMIZE FOR YOUR ENVIRONMENT
# =============================================================================

# Application Configuration
APP_NAME=recipix
NODE_ENV=production

# Network Configuration
BACKEND_PORT=3001
HOST_PORT=8080
FRONTEND_URL=https://example.com/receipts
CORS_ORIGIN=https://example.com

# Path Configuration
APP_BASE_PATH=/my-path/fintools
PUBLIC_BASE_PATH=/receipts
API_BASE_URL=https://example.com/receipts/api

# =============================================================================
# SECURITY CONFIGURATION - GENERATE SECURE KEYS FOR PRODUCTION
# =============================================================================

# IMPORTANT: Generate secure keys using:
# openssl rand -base64 32

# JWT Secret (REQUIRED - Replace with secure key)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY_IN_PRODUCTION

# Session Secret (REQUIRED - Replace with secure key)
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_SESSION_SECRET_IN_PRODUCTION

# Bcrypt Rounds (12 is recommended for production)
BCRYPT_ROUNDS=12

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type
DB_TYPE=sqlite
DB_FILE_PATH=/app/data/recipix.db

# Uncomment and configure for external database:
# DB_HOST=your-database-host
# DB_PORT=5432
# DB_NAME=recipix
# DB_USER=recipix_user
# DB_PASSWORD=SECURE_DATABASE_PASSWORD

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads
LOG_DIR=/app/logs
DATA_DIR=/app/data

# =============================================================================
# EXTERNAL SERVICES (Configure as needed)
# =============================================================================

# Firefly III Configuration
# FIREFLY_III_URL=https://your-firefly-instance.com
# FIREFLY_III_TOKEN=your-personal-access-token

# OCR Service Configuration
# OCR_API_KEY=your-ocr-api-key
# OCR_SERVICE_URL=https://api.ocr.space/parse/image

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
